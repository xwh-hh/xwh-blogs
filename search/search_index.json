02  \u53c8\u60f3\u4e86 1h\uff0c\u53d1\u73b0 \\(O(n^2)\\) \u90fd\u60f3\u4e0d\u51fa\u6765\u3002 \u4e8e\u662f\u653e\u6389 T1\uff0c\u611f\u89c9 T2 \u662f\u4e2a\u5b50\u96c6\u5377\u79ef\u4f18\u5316\u72b6\u538b dp\uff0c\u7136\u540e\u88ab\u6211\u81ea\u5df1 hack \u4e86\u3002 \u51c6\u5907\u5148\u5199\u66b4\u529b\uff0c\u5199\u7740\u5199\u7740\u53d1\u73b0\u81ea\u5df1\u8fde\u66b4\u529b\u90fd\u6253\u4e0d\u51fa\u3002 \u540e\u6765\u770b\u4e86\u7279\u6b8a\u6027\u8d28\uff0c\u505a\u51fa\u4e86\u4ed9\u4eba\u638c\u56fe\uff0c\u5e94\u62ff \\(8\\) \u5206\u3002 \u7136\u540e UOJ pretest \u7ed9\u4e86 \\(12\\) \u5206\uff0c\u4f55\u610f\u5473\uff1f \u53d1\u73b0 Sub1 \u7684 pretest \u8fc7\u6c34\uff0c\u51b3\u5b9a\u91cd\u65b0\u6253\u66b4\u529b\uff0c\u62fc\u4e09\u4e2a Sub \u62ff \\(20\\) \u5206\u3002 \u6253\u5b8c\u540e\u518d\u770b T1\uff0c\u6d6a\u8d39 20min \u540e\u8f6c\u5411 T3\uff0c\u53d1\u73b0 \\(n=10^5\\) \u600e\u4e48\u90fd\u60f3\u4e0d\u51fa\u6765\uff0c\u770b\u5230\u94fe\u72b6\u56fe\uff0c\u53d1\u73b0\u53ef\u4ee5 01 \u5316\u4ee5\u540e odt \u505a\u5230 \\(O(n\\log n)\\)\uff0c\u5728\u7ed3\u675f\u524d 10min \u62ff\u4e0b\u3002 \u540e\u6765\u51fa\u5206\u3002\u6ca1\u6302\u3002</p>"},{"location":"%E4%BF%A1%E7%AB%9E/unr10/#day-2_1","title":"Day 2+","text":"<p>\u603b\u5206 \\(100+100+7+5+47+20+20=299\\)\u3002\u559c\u83b7\u94c1\u724c\u3002</p>"},{"location":"%E5%A4%A7%E6%95%B0/","title":"\u5927\u5b66\u6570\u5b66","text":""},{"location":"%E5%A4%A7%E7%89%A9/","title":"\u5927\u5b66\u7269\u7406","text":""},{"location":"%E6%95%B0%E7%AB%9E/","title":"\u6570\u5b66\u7ade\u8d5b","text":""},{"location":"%E6%95%B0%E7%AB%9E/ex%E6%9F%AF%E8%A5%BF/","title":"\u67ef\u897f\u4e0d\u7b49\u5f0f\u884d\u751f\u7269","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%87%A0%E4%BD%95/","title":"\u51e0\u4f55","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%9D%87%E5%80%BC/","title":"\u5747\u503c\u4e0d\u7b49\u5f0f","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%9F%BA%E6%9C%AC%E4%B8%8D%E7%AD%89%E5%BC%8F/","title":"\u57fa\u672c\u4e0d\u7b49\u5f