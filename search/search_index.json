{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"]},"docs":[{"location":"","title":"\u524d\u8a00","text":"<p>\u8fd9\u91cc\u4f1a\u5199\u4e00\u4e9b\u5b66\u4e60\u8d44\u6599\u3002 \u5404\u79cd\u96be\u5ea6\u90fd\u6709\u3002</p>"},{"location":"%E4%BF%A1%E7%AB%9E/","title":"\u4fe1\u606f\u7ade\u8d5b","text":""},{"location":"%E4%BF%A1%E7%AB%9E/OIrecall/","title":"OI \u56de\u5fc6\u5f55","text":""},{"location":"%E4%BF%A1%E7%AB%9E/unr10/","title":"UOJ NOI Round 10 \u6e38\u8bb0","text":"<p>\u8fd9\u662f\u5931\u8d25\u8005 xwh_hh \u7684\u6545\u4e8b\u3002 \u8fd9\u4e5f\u662f xwh_hh \u7684\u7b2c\u4e00\u573a\uff08\u4e0d\u77e5\u9053\u662f\u4e0d\u662f\u6700\u540e\u4e00\u573a\uff09NOI \u6a21\u62df\u8d5b\u3002  </p>"},{"location":"%E4%BF%A1%E7%AB%9E/unr10/#day-0","title":"Day 0","text":"<p>NOI \u7b14\u8bd5\u6a21\u62df\u3002\u6211\u600e\u4e48\uff0c\u770b\u4e86\u4e00\u4e0b\u5348 ccf \u7684\u6587\u6863\u5c31 ak \u4e86\uff1f \u611f\u89c9\u7528\u6389\u4e86 inf \u70b9 rp\uff0c\u4f18\u52bf\u4e0d\u5728\u6211\u3002</p>"},{"location":"%E4%BF%A1%E7%AB%9E/unr10/#day-1","title":"Day 1","text":"<p>\u673a\u8bd5\u7b2c\u4e00\u5929\u3002\u5bf9\u7740 T1 \u60f3\u4e86 3h+ \u7ec8\u4e8e\u60f3\u51fa\u4e86 \\(O(n\\log n)\\) \u505a\u6cd5\uff0c\u7136\u540e\u53d1\u73b0\u540e\u9762\u4e00\u70b9\u4e0d\u4f1a\uff0c\u624b\u6413\u4e86\u4e24\u4e2a\u66b4\u529b\uff0c\u6700\u540e \\(100+7+5=112\\)\u3002 UOJ \u6700\u7ec8\u8bc4\u6d4b\uff0c\u6ca1\u6302\u3002 \u53d1\u73b0 hly \u62ff\u4e86 \\(200\\) \u5206\uff0c\u5413\u54ed\u4e86\u3002 \u770b\u4e86\u9898\u89e3\uff0c\u4e00\u70b9\u4e0d\u4f1a\u3002</p>"},{"location":"%E4%BF%A1%E7%AB%9E/unr10/#day-2","title":"Day 2","text":"<p>\u673a\u8bd5\u7b2c\u4e8c\u5929\uff0c\u51b3\u5b9a\u5148\u6253\u66b4\u529b\uff0c\u5199\u4e86 T3 \u7684 \\(8\\) \u5206\u3002 \u7136\u540e\u5bf9\u7740 T1 \u72af\u7389\u7389\u75c7\uff0c\u8017\u65f6 2h \u60f3\u51fa \\(O(n^3)\\) \u7684\u533a\u95f4 dp\u3002  \u53c8\u60f3\u4e86 1h\uff0c\u53d1\u73b0 \\(O(n^2)\\) \u90fd\u60f3\u4e0d\u51fa\u6765\u3002 \u4e8e\u662f\u653e\u6389 T1\uff0c\u611f\u89c9 T2 \u662f\u4e2a\u5b50\u96c6\u5377\u79ef\u4f18\u5316\u72b6\u538b dp\uff0c\u7136\u540e\u88ab\u6211\u81ea\u5df1 hack \u4e86\u3002 \u51c6\u5907\u5148\u5199\u66b4\u529b\uff0c\u5199\u7740\u5199\u7740\u53d1\u73b0\u81ea\u5df1\u8fde\u66b4\u529b\u90fd\u6253\u4e0d\u51fa\u3002 \u540e\u6765\u770b\u4e86\u7279\u6b8a\u6027\u8d28\uff0c\u505a\u51fa\u4e86\u4ed9\u4eba\u638c\u56fe\uff0c\u5e94\u62ff \\(8\\) \u5206\u3002 \u7136\u540e UOJ pretest \u7ed9\u4e86 \\(12\\) \u5206\uff0c\u4f55\u610f\u5473\uff1f \u53d1\u73b0 Sub1 \u7684 pretest \u8fc7\u6c34\uff0c\u51b3\u5b9a\u91cd\u65b0\u6253\u66b4\u529b\uff0c\u62fc\u4e09\u4e2a Sub \u62ff \\(20\\) \u5206\u3002 \u6253\u5b8c\u540e\u518d\u770b T1\uff0c\u6d6a\u8d39 20min \u540e\u8f6c\u5411 T3\uff0c\u53d1\u73b0 \\(n=10^5\\) \u600e\u4e48\u90fd\u60f3\u4e0d\u51fa\u6765\uff0c\u770b\u5230\u94fe\u72b6\u56fe\uff0c\u53d1\u73b0\u53ef\u4ee5 01 \u5316\u4ee5\u540e odt \u505a\u5230 \\(O(n\\log n)\\)\uff0c\u5728\u7ed3\u675f\u524d 10min \u62ff\u4e0b\u3002 \u540e\u6765\u51fa\u5206\u3002\u6ca1\u6302\u3002</p>"},{"location":"%E4%BF%A1%E7%AB%9E/unr10/#day-2_1","title":"Day 2+","text":"<p>\u603b\u5206 \\(100+100+7+5+47+20+20=299\\)\u3002 \u94dc\u724c\u7ebf \\(259\\)\u3002 \uff1f\uff01jiazhichen844 \\(298\\) \u5206\uff01\uff1f  </p> <p></p> <p>\u7b97\u4e0a noiwc2026\uff0c\u76ee\u524d 2 \u679a\u94dc\u724c\u3002</p> <p>\u4e5f\u8bb8\uff0c\u6211\u6ca1\u6709\u94f6\u724c\u7684\u6c34\u5e73\uff0c\u65e0\u8bba\u4ec0\u4e48\u6bd4\u8d5b\u3002</p> <p>\u6211\uff0c\u53ea\u6709\u8fd9\u4e2a\u80fd\u8010\u5427\u3002</p>"},{"location":"%E5%A4%A7%E6%95%B0/","title":"\u5927\u5b66\u6570\u5b66","text":"<p>\u5495\u5495\u5495\u3002</p>"},{"location":"%E5%A4%A7%E7%89%A9/","title":"\u5927\u5b66\u7269\u7406","text":""},{"location":"%E6%95%B0%E7%AB%9E/","title":"\u6570\u5b66\u7ade\u8d5b","text":""},{"location":"%E6%95%B0%E7%AB%9E/ex%E6%9F%AF%E8%A5%BF/","title":"\u67ef\u897f\u4e0d\u7b49\u5f0f\u884d\u751f\u7269","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%87%A0%E4%BD%95/","title":"\u51e0\u4f55","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%9D%87%E5%80%BC/","title":"\u5747\u503c\u4e0d\u7b49\u5f0f","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E5%9F%BA%E6%9C%AC%E4%B8%8D%E7%AD%89%E5%BC%8F/","title":"\u57fa\u672c\u4e0d\u7b49\u5f0f","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E6%95%B0%E8%AE%BA/","title":"\u6570\u8bba","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E6%9F%AF%E8%A5%BF/","title":"\u67ef\u897f\u4e0d\u7b49\u5f0f","text":""},{"location":"%E6%95%B0%E7%AB%9E/%E7%BB%84%E5%90%88/","title":"\u7ec4\u5408","text":""},{"location":"%E6%9D%82%E9%A1%B9/","title":"\u6742\u9879","text":""},{"location":"%E6%9D%82%E9%A1%B9/6202%E5%B9%B4OIers%E7%BB%9F%E4%B8%80%E8%80%83%E8%AF%95%E8%AF%AD%E6%96%87/","title":"6202 \u5e74 OIers \u7edf\u4e00\u8003\u8bd5 \u8bed\u6587\u79d1\u76ee","text":"<p>\u6ce8\uff1a\u5185\u5bb9\u7eaf\u5c5e\u5a31\u4e50\u3002</p>"},{"location":"%E6%9D%82%E9%A1%B9/6202%E5%B9%B4OIers%E7%BB%9F%E4%B8%80%E8%80%83%E8%AF%95%E8%AF%AD%E6%96%87/#_1","title":"\u7b2c\u4e00\u90e8\u5206 \u8bed\u53e5\u8865\u5168","text":"<ol> <li>ccf \u7684\u5168\u79f0\u662f______\u3002</li> <li>____\u94fa\u5c31\u7684\uff0c\u672a\u5fc5\u662f\u5f52\u9014\u3002</li> <li>\u628a\u672c\u5377\u80cc\u9762\u6d82\u6ee1\u80f6\u6c34\uff0c\u4f60\u5c06\u5f97\u5230\u4e00\u5f20____\u3002</li> <li></li> </ol>"},{"location":"%E6%9D%82%E9%A1%B9/6202%E5%B9%B4OIers%E7%BB%9F%E4%B8%80%E8%80%83%E8%AF%95%E8%AF%AD%E6%96%87/#_2","title":"\u7b2c\u4e8c\u90e8\u5206 \u7b80\u7b54\u9898","text":"<ol> <li>\u5982\u4f55\u5feb\u901f\u5728\u4e0d\u4f1a\u7684\u9898\u76ee\u4e0a\u5f97\u5230 \\(45\\%\\) \u7684\u5206\u6570\uff1f_____\u3002</li> </ol>"},{"location":"%E6%9D%82%E9%A1%B9/6202%E5%B9%B4OIers%E7%BB%9F%E4%B8%80%E8%80%83%E8%AF%95%E8%AF%AD%E6%96%87/#_3","title":"\u7b2c\u4e09\u90e8\u5206 \u9605\u8bfb\u9898","text":"<p>\u9605\u8bfb\u4e0b\u9762\u7684\u6587\u5b57\uff0c\u56de\u7b54\u95ee\u9898\u3002</p> <p>\u6211\u5e38\u5e38\u8ffd\u5fc6\u8fc7\u53bb\u3002</p> <p>\u751f\u547d\u77ac\u95f4\u5b9a\u683c\u5728\u8111\u6d77\u3002\u6211\u5c06\u80cc\u540e\u7684\u65f6\u95f4\u88c1\u526a\u3001\u6298\u53e0\u3001\u8737\u66f2\uff0c\u63c9\u637b\u6210\u5929\u4e0a\u6735\u6735\u767d\u4e91\u3002</p> <p>\u4e91\u6735\u4e4b\u95f4\u4ea6\u6709\u5206\u522b\uff1a\u79ef\u4e91\u539a\u91cd\uff0c\u800c\u5377\u4e91\u98d8\u6e3a\u3002\u751f\u547d\u91cc\u9707\u64bc\u7684\u573a\u666f\u63a0\u8fc7\u6211\u7684\u601d\u7eea\u4fbf\u4e00\u751f\u65e0\u6cd5\u5fd8\u6000\uff0c\u800c\u66f4\u4e3a\u666e\u901a\u5e73\u5e38\u7684\u8bb0\u5fc6\u5728\u65f6\u95f4\u7684\u51b2\u5237\u4e0b\u53ea\u7559\u4e0b\u4e9b\u8bb8\u6b8b\u9ab8\u3002\u8ffd\u5fc6\u5b9b\u5982\u5165\u68a6\uff0c\u592a\u8fc7\u6e05\u695a\u5219\u65e0\u6cd5\u6109\u60a6\u81ea\u5df1\u7684\u5e7b\u60f3\uff0c\u8fc7\u5206\u6a21\u7cca\u5374\u53c8\u5760\u5165\u865a\u65e0\u3002\u53ea\u6709\u8584\u96fe\u95f4\u7684\u5c71\u6c34\uff0c\u9762\u7eb1\u4e0b\u7684\u5973\u5b50\uff0c\u90a3\u6070\u5230\u597d\u5904\u7684\u6726\u80e7\uff0c\u624d\u80fd\u6ee1\u8db3\u6211\u5bf9\u7f8e\u7684\u82db\u6c42\u3002</p> <p>\u8ffd\u5fc6\u603b\u5728\u4e0d\u7ecf\u610f\u95f4\u5c06\u6211\u88f9\u8fdb\u6cdb\u9ec4\u7684\u7eb8\u9875\u91cc\u3002\u5206\u522b\u53c8\u91cd\u805a\u7684\u670b\u53cb\uff0c\u63a8\u5012\u53c8\u91cd\u5efa\u7684\u8857\u9053\uff0c\u79cd\u79cd\u7ebf\u7d22\u534f\u52a9\u7740\u6211\u4ece\u4e00\u4e2a\u5177\u4f53\u7684\u65f6\u523b\u51fa\u53d1\u6cbf\u65f6\u95f4\u7684\u6cb3\u9006\u6d41\u800c\u4e0a\u3002\u66fe\u7ecf\u7684\u65e5\u5b50\u65e0\u6cd5\u91cd\u6765\uff0c\u6211\u53ea\u4e0d\u8fc7\u662f\u4e00\u4e2a\u8fc7\u5ba2\u3002\u4f46\u6211\u4ecd\u7136\u6e34\u671b\u5728\u6bcf\u4e00\u6b21\u8ffd\u5fc6\u4e4b\u65c5\u4e2d\u7559\u4e0b\u95f2\u6687\u65f6\u95f4\uff0c\u5728\u4e00\u4e2a\u573a\u666f\u524d\u9a7b\u8db3\uff0c\u5728\u5c81\u6708\u7684\u6726\u80e7\u91cc\u77ad\u671b\u8fc7\u53bb\u7684\u81ea\u5df1\uff0c\u611f\u53d7\u5c3d\u53ef\u80fd\u591a\u7684\u751c\u871c\u3002\u7f8e\u597d\u7684\u65f6\u5149\u66fe\u6d41\u8fc7\u6211\u7684\u8eab\u4f53\uff0c\u6211\u4fbf\u5fc3\u6ee1\u610f\u8db3\u3002</p> <p>\u8fc7\u53bb\u5df2\u7ecf\u51dd\u56fa\uff0c\u6211\u5e26\u7740\u56de\u5fc6\u5411\u524d\uff0c\u53ea\u662f\u65f6\u5e38\u758f\u4e8e\u4fdd\u7ba1\uff0c\u56de\u5fc6\u4e5f\u5728\u6539\u53d8\u7740\u5404\u81ea\u7684\u5f62\u6001\u3002\u8fd9\u7ed9\u6211\u7684\u8ffd\u5fc6\u65c5\u7a0b\u5e26\u6765\u4e9b\u8bb8\u6311\u6218\u3002</p> <p>\u6211\u8be5\u5728\u54ea\u91cc\u505c\u7559\uff1f\u6211\u95ee\u6211\u81ea\u5df1\u3002</p>"},{"location":"%E6%9D%82%E9%A1%B9/%E9%85%8D%E7%BD%AE%E8%AF%B4%E6%98%8E/","title":"\u914d\u7f6e\u8bf4\u660e","text":"<p>\u8fd9\u662f xwh_hh \u7684 Wiki\uff0c\u57fa\u4e8e Github Pages + MkDocs + Material for MkDocs \u4e3b\u9898\u642d\u5efa\uff0c\u652f\u6301 Markdown \u548c LaTeX \u516c\u5f0f\u3002</p>"},{"location":"%E6%9D%82%E9%A1%B9/%E9%85%8D%E7%BD%AE%E8%AF%B4%E6%98%8E/#_2","title":"\u4f5c\u8005\u5982\u4f55\u6dfb\u52a0\u6587\u7ae0\uff1f","text":"<p>\u5728 <code>docs\\\u6240\u5c5e\u5206\u7c7b\\</code> \u4e2d\u65b0\u5efa <code>\u6807\u9898.md</code>\uff0c\u5728 <code>mkdocs.yml</code> \u7684 <code>nav</code> \u4e2d\u6ce8\u518c\u3002 \u9884\u89c8\uff08cmd \u5728 my-docs \u4e2d\uff09\uff1a <pre><code>mkdocs-env\\Scripts\\activate\nmkdocs serve\n</code></pre></p> <p>\u4e0a\u7ebf\uff08cmd \u5728 my-docs \u4e2d\uff09\uff1a <pre><code>mkdocs-env\\Scripts\\activate\ngit add .\ngit commit -m \"\u6dfb\u52a0\u6587\u7ae0\"\nmkdocs gh-deploy\n</code></pre></p>"},{"location":"%E6%9D%82%E9%A1%B9/%E9%85%8D%E7%BD%AE%E8%AF%B4%E6%98%8E/#wiki","title":"\u8fd9\u4e2a Wiki \u770b\u8d77\u6765\u4e0d\u9519\uff0c\u600e\u4e48\u5b9e\u73b0\uff1f","text":"<p>\u5495\u5495\u5495\u3002 \u60a8\u53ef\u4ee5\u76f8\u4fe1 Deepseek \u5feb\u901f\u6a21\u5f0f + \u6df1\u5ea6\u601d\u8003 + \u8054\u7f51\u641c\u7d22\uff0c\u6211\u5c31\u662f\u5728\u5b83\u7684\u6307\u5bfc\u4e0b\u5b8c\u6210\u7684\u3002</p>"},{"location":"%E9%AB%98%E6%95%B0/","title":"\u9ad8\u4e2d\u6570\u5b66","text":""},{"location":"%E9%AB%98%E7%89%A9/","title":"\u9ad8\u4e2d\u7269\u7406","text":""}]}